<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.8.0</Version>
    <ApplicationIcon>../packaging/assets/lanvibes.ico</ApplicationIcon>
    <Product>LanVibes</Product>
    <Description>LanVibes workstation network diagnostics</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <DebugType Condition="'$(DesktopPackage)' == 'true'">none</DebugType>
    <DebugSymbols Condition="'$(DesktopPackage)' == 'true'">false</DebugSymbols>
    <OutputType Condition="'$(DesktopPackage)' == 'true' And $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-'))">WinExe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../NOTICE" Link="NOTICE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../licenses/**" Link="licenses/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="diagnostics.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="wwwroot/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>


